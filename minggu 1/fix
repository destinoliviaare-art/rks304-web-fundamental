  padding: 0.75rem 0.85rem;
  font-family: var(--font-body);
  font-size: 0.95rem;
  border: 1px solid var(--color-line);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  color: var(--color-ink);
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.form-field input:focus,
.form-field select:focus,
.form-field textarea:focus {
  border-color: var(--color-pine);
  box-shadow: 0 0 0 3px rgba(78, 155, 114, 0.15);
}

.form-field textarea { resize: vertical; }

.btn-submit {
  font-family: var(--font-body);
  font-size: 1rem;
  font-weight: 600;
  background: var(--color-pine);
  color: #fff;
  border: none;
  padding: 0.85rem 1.8rem;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: background 0.2s ease, transform 0.15s ease;
}

.btn-submit:hover { background: var(--color-pine-dark); }
.btn-submit:active { transform: translateY(1px); }

.form-status {
  margin-top: 1rem;
  font-size: 0.9rem;
  color: var(--color-pine-dark);
  min-height: 1.2em;
}

/* ---------- Reveal halus saat elemen masuk viewport ---------- */
.reveal {
  opacity: 0;
  transform: translateY(16px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}
.reveal.is-visible {
  opacity: 1;
  transform: translateY(0);
}

/* ---------- Footer ---------- */
.site-footer {
  border-top: 1px solid var(--color-line);
  padding: 2rem 0;
  color: var(--color-ink-soft);
  font-size: 0.85rem;
}

/* ---------- Responsive ---------- */
@media (max-width: 720px) {
  .hero .wrap { grid-template-columns: 1fr; }
  .hero-photo-frame { width: 168px; height: 168px; }
  .hero-photo { width: 130px; height: 130px; }
