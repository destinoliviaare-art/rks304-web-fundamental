<style>
/* =========================================================
   Destin Olivia Rengganis — Personal Profile
   Vanilla CSS, no framework.
   ========================================================= */

:root {
  --color-bg: #FDF2F6;
  --color-surface: #FFFFFF;
  --color-ink: #2E2630;
  --color-ink-soft: #7A6B71;
  --color-pine: #4E9B72;
  --color-pine-dark: #386B4F;
  --color-ochre: #F3C94F;
  --color-ochre-soft: #FBE9B8;
  --color-butter: #F0C35E;
  --color-tomato: #E8756B;
  --color-line: #F1DCE4;
  --color-mint-bg: #EAF7EE;
  --color-blush-deep: #F7E1EA;

  --font-display: "Fraunces", "Iowan Old Style", Georgia, serif;
  --font-name: "Playfair Display", "Iowan Old Style", Georgia, serif;
  --font-body: "Inter", "Segoe UI", system-ui, sans-serif;
  --font-mono: "IBM Plex Mono", "Courier New", monospace;

  --max-width: 980px;
  --gap: 1.5rem;
  --radius-sm: 4px;
  --radius-md: 10px;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }

body {
  margin: 0;
  color: var(--color-ink);
  font-family: var(--font-body);
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
  background-color: var(--color-bg);
  background-image: url("data:image/png;base64,");
  background-repeat: repeat;
  background-size: 300px 300px;
  background-attachment: fixed;
}

img { max-width: 100%; display: block; }

a {
  color: var(--color-pine-dark);
}

a:focus-visible,
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
  outline: 3px solid var(--color-ochre);
  outline-offset: 2px;
}

.wrap {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 1.5rem;
}

/* skip link for keyboard users */
.skip-link {
  position: absolute;
  left: -999px;
  top: auto;
  background: var(--color-ink);
  color: #fff;
  padding: 0.7rem 1.1rem;
  border-radius: var(--radius-sm);
  z-index: 100;
}
.skip-link:focus {
  left: 1rem;
  top: 1rem;
}

/* ---------- Header & Nav ---------- */
.site-header {
  border-bottom: 1px solid var(--color-line);
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(6px);
  position: sticky;
  top: 0;
  z-index: 10;
}

.site-header .wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 1.1rem;
  padding-bottom: 1.1rem;
}

.main-nav {
  position: relative;
}

.brand {
  font-family: var(--font-display);
  font-size: 1.35rem;
  font-weight: 600;
  color: var(--color-ink);
  text-decoration: none;
}
.brand em {
  font-style: normal;
  color: var(--color-pine);
}

.main-nav ul {
  list-style: none;
  display: flex;
  gap: 0.4rem;
  margin: 0;
  padding: 0;
  position: relative;
}

.main-nav a, .main-nav button {
  text-decoration: none;
  color: var(--color-ink-soft);
  font-size: 0.98rem;
  padding: 0.5rem 1rem;
  border-radius: 10px;
  border: 2px solid transparent;
  transition: color 0.2s ease;
  display: inline-block;
  position: relative;
  z-index: 1;
}

.main-nav a:hover, .main-nav button:hover {
  color: var(--color-pine-dark);
}

.main-nav a[aria-current="page"], .main-nav button.active {
  color: var(--color-pine-dark);
  font-weight: 600;
}

/* kotak bertepi tumpul (rounded) berwarna butter yellow,
   meluncur ke tautan yang sedang aktif / di-hover */
.nav-indicator {
  position: absolute;
  top: 0;
  height: 0;
  border-radius: 10px;
  border: 2px solid var(--color-butter);
  background: rgba(240, 195, 94, 0.12);
  transition: left 0.3s cubic-bezier(.65,0,.35,1),
              width 0.3s cubic-bezier(.65,0,.35,1),
              top 0.3s cubic-bezier(.65,0,.35,1),
              height 0.3s cubic-bezier(.65,0,.35,1),
              opacity 0.2s ease;
  left: 0;
  width: 0;
  opacity: 0;
  z-index: 2;
  pointer-events: none;
}
.nav-indicator.is-visible { opacity: 1; }

/* ---------- Hero ---------- */
.hero {
  padding: 4.5rem 0 3.5rem;
  overflow: hidden;
}

.hero .wrap {
  display: grid;
  grid-template-columns: 1fr 220px;
  gap: 3rem;
  align-items: center;
}

.hero-photo-frame {
  position: relative;
  width: 250px;
  height: 250px;
}

.hero-photo {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 194px;
  height: 194px;
  border-radius: 50%;
  object-fit: cover;
}

.hero-photo-lace {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  pointer-events: none;
  user-select: none;
}

.eyebrow {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  color: var(--color-pine);
  margin: 0 0 0.6rem;
}

.hero h1 {
  font-family: var(--font-name);
  font-style: italic;
  font-weight: 600;
  font-size: clamp(2.2rem, 4vw, 3.4rem);
  line-height: 1.15;
  letter-spacing: 0.2px;
  margin: 0 0 0.4rem;
}

/* decrypt-in name animation: letters resolve from a cipher state once on load */
.decrypt-name .char {
  display: inline-block;
}

.hero .role {
  font-size: 1.15rem;
  color: var(--color-ink-soft);
  margin: 0 0 1.2rem;
}

.hero .bio {
  max-width: 58ch;
  margin: 0 0 0.9rem;
}
.hero .bio:last-of-type {
  margin-bottom: 0;
}

/* ---------- Generic sections ---------- */
.section {
  padding: 3.5rem 0;
  border-top: 1px solid var(--color-line);
}
.section.tinted {
  background: var(--color-mint-bg);
}

.section-heading {
  font-family: var(--font-display);
  font-size: 1.7rem;
  margin: 0 0 1.5rem;
}

.page-intro {
  padding-top: 3.5rem;
  border-top: none;
}
.page-intro .lede {
  color: var(--color-ink-soft);
  max-width: 60ch;
  margin: 0.5rem 0 2rem;
}
.page-intro h1 {
  font-family: var(--font-display);
  font-size: clamp(1.9rem, 3.4vw, 2.4rem);
  margin: 0 0 0.3rem;
}

/* ---------- Skills & timeline ---------- */
.skills-badges {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  margin: 0 0 2.75rem;
  padding: 0;
}

.skills-badges li {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  background: var(--color-surface);
  border: 1px solid var(--color-line);
  padding: 0.4rem 0.8rem;
  border-radius: var(--radius-sm);
  color: var(--color-pine-dark);
}

.timeline {
  list-style: none;
  margin: 0;
  padding: 0;
  border-left: 2px solid var(--color-line);
}

.timeline li {
  position: relative;
  padding: 0 0 1.6rem 1.5rem;
}

.timeline li::before {
  content: "";
  position: absolute;
  left: -6px;
  top: 4px;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--color-ochre);
}

.timeline .when {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--color-ink-soft);
  display: block;
  margin-bottom: 0.15rem;
}

.timeline .what { font-weight: 600; }
.timeline p { margin: 0.3rem 0 0; color: var(--color-ink-soft); }

/* ---------- Project grid (portfolio) ---------- */
.project-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
  gap: var(--gap);
}

.card {
  background: var(--color-surface);
  border: 1px solid var(--color-line);
  border-radius: var(--radius-md);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  will-change: transform;
  transform: perspective(800px) rotateX(0deg) rotateY(0deg);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.card:hover,
.card:focus-within {
  box-shadow: 0 14px 28px -18px rgba(46, 38, 48, 0.35);
}

.card-thumb-wrap {
